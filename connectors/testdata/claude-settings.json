{
  "model": "sonnet",
  "env": {"EDITOR_MODE": "vim"},
  "permissions": {
    "allow": ["Bash(git status)", "Read(~/notes/**)", "Bash(ls *)"],
    "deny": ["Bash(rm -rf *)"],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {"matcher": "startup", "hooks": [{"type": "command", "command": "echo foreign-claude-start"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "echo foreign-pre"}]}
    ]
  },
  "statusLine": {"type": "command", "command": "echo status"}
}
